<Defaults>
  <Button fontStyle="Bold" fontSize="12" textColor="#f8f2e2" />
  <Text color="#f0e4c8" fontSize="12" />
</Defaults>

<Panel id="qvHudRoot"
       rectAlignment="MiddleLeft"
       offsetXY="14 20"
       width="298"
       height="712"
       color="#181512F2"
       outline="#b89248"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">

  <!-- Header bar -->
  <HorizontalLayout rectAlignment="UpperCenter" height="32" padding="10 6 4 4" spacing="4" color="#262018FF">
    <Text id="qvTitle" text="THE QUIET VALE v7.0" fontSize="13" fontStyle="Bold" color="#e8c474" alignment="MiddleLeft" flexibleWidth="1" />
    <Button id="qvToggleBtn" text="-" preferredWidth="28" minWidth="28" color="#3a3126" onClick="onHudToggle" tooltip="Collapse / Expand Control Panel" />
  </HorizontalLayout>

  <!-- Main collapsible body -->
  <VerticalLayout id="qvHudBody" rectAlignment="UpperCenter" offsetXY="0 -34" height="672" padding="8 8 6 8" spacing="5" childForceExpandHeight="false" childControlHeight="true">

    <!-- Status & Guided Phase Banner -->
    <Text id="qvStatus" text="Season I  |  Round 1/12  |  2P (4 Act)" fontSize="11" fontStyle="Bold" color="#d8e6c8" alignment="MiddleCenter" minHeight="16" preferredHeight="16" />
    <Text id="qvPhaseCue" text="Next: Click 1P-5P Setup or Reveal Encounters" fontSize="10" fontStyle="Italic" color="#ecd084" alignment="MiddleCenter" minHeight="14" preferredHeight="14" />

    <!-- Turn, Actions & Steward Once-Per-Season Power -->
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="4" color="#242019CC" padding="4 4 2 2">
      <Text id="qvTurnInfo" text="Seat 1 (Vanguard) · 4/4" fontSize="11" fontStyle="Bold" color="#f5dc9c" flexibleWidth="1" alignment="MiddleLeft" />
      <Button text="-" preferredWidth="22" minWidth="22" color="#4a2a26" onClick="onHudActMinus" tooltip="Spend 1 Action" />
      <Button text="+" preferredWidth="22" minWidth="22" color="#2a4a2e" onClick="onHudActPlus" tooltip="Refund 1 Action" />
      <Button id="btnNextTurn" text="NEXT TURN" preferredWidth="80" minWidth="80" fontSize="10" color="#3a4c62" onClick="onHudNextTurn" tooltip="Advance to next player seat and reset Actions" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="24" preferredHeight="24" spacing="4">
      <Text id="qvPowerStatus" text="Steward Power: READY (1/Season)" fontSize="10" color="#a8d8a2" flexibleWidth="1" alignment="MiddleLeft" />
      <Button id="btnUsePower" text="USE POWER" preferredWidth="86" minWidth="86" fontSize="10" color="#355844" onClick="onHudUsePower" tooltip="Use active Steward's once-per-Season power (auto-refreshes at Seasons II &amp; III)" />
    </HorizontalLayout>

    <!-- 1-5P Setup -->
    <Text text="SETUP (STEWARDS + WAREHOUSE + HANDS)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="4">
      <Button id="btnSetup1" text="1P" color="#2e2922" onClick="onHudSetup(1)" tooltip="1P: 4 Actions, 15 Warehouse, 5/3/4 Encounters" />
      <Button id="btnSetup2" text="2P" color="#7a5d26" onClick="onHudSetup(2)" tooltip="2P: 4 Actions, 10 Warehouse, 8/8/8 Encounters" />
      <Button id="btnSetup3" text="3P" color="#2e2922" onClick="onHudSetup(3)" tooltip="3P: 3 Actions, 8 Warehouse, 12/12/12 Encounters" />
      <Button id="btnSetup4" text="4P" color="#2e2922" onClick="onHudSetup(4)" tooltip="4P: 3 Actions, 0 Warehouse, 16/16/16 Encounters" />
      <Button id="btnSetup5" text="5P" color="#2e2922" onClick="onHudSetup(5)" tooltip="5P: 2 Actions, 0 Warehouse, 26/14/20 Encounters" />
    </HorizontalLayout>
    <Button id="btnQuickSeed" text="QUICK-SEED ENCOUNTER DECK" minHeight="24" preferredHeight="24" fontSize="10" color="#3c3428" onClick="onHudQuickSeed" tooltip="Merge dealt hands + draw pile into shuffled Encounter Deck" />

    <!-- Round Flow Actions -->
    <Text text="ROUND FLOW (RIGHT-CLICK TILES &amp; CARDS)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
    <Button id="btnRevealEnc" text="REVEAL ENCOUNTERS (2 CARDS)" minHeight="30" preferredHeight="30" fontSize="12" color="#8c6320" onClick="onHudRevealEncounters" tooltip="Flip P Encounter cards into In Play &amp; auto-place 3 Timers on Arrivals" />
    <Button id="btnDrawTarget" text="DRAW TARGET CARD" minHeight="26" preferredHeight="26" fontSize="11" color="#32485a" onClick="onHudDrawTarget" tooltip="Return previous Target Card to bottom, flip next card, and broadcast criteria" />
    <Button id="btnEndRound" text="END ROUND 1 -> 2" minHeight="30" preferredHeight="30" fontSize="12" color="#2d5a36" onClick="onHudEndRound" tooltip="Clear X tokens, tick Arrival timers (-1), advance Round, rotate Player 1" />

    <!-- Warehouse Live Counters -->
    <Text text="WAREHOUSE (CAP 15)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
    <GridLayout cellSize="136 23" spacing="8 4" minHeight="78" preferredHeight="78">
      <HorizontalLayout spacing="2">
        <Text text="Wood" preferredWidth="46" fontSize="11" color="#a6c890" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(4)" />
        <Text id="whVal4" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(4)" />
      </HorizontalLayout>
      <HorizontalLayout spacing="2">
        <Text text="Stone" preferredWidth="46" fontSize="11" color="#b6c0c6" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(1)" />
        <Text id="whVal1" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(1)" />
      </HorizontalLayout>
      <HorizontalLayout spacing="2">
        <Text text="Metal" preferredWidth="46" fontSize="11" color="#9ab8ca" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(2)" />
        <Text id="whVal2" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(2)" />
      </HorizontalLayout>
      <HorizontalLayout spacing="2">
        <Text text="Food" preferredWidth="46" fontSize="11" color="#d8c66e" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(5)" />
        <Text id="whVal5" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(5)" />
      </HorizontalLayout>
      <HorizontalLayout spacing="2">
        <Text text="Herbs" preferredWidth="46" fontSize="11" color="#bfa0d0" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(6)" />
        <Text id="whVal6" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(6)" />
      </HorizontalLayout>
      <HorizontalLayout spacing="2">
        <Text text="Goods" preferredWidth="46" fontSize="11" color="#d69676" />
        <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(3)" />
        <Text id="whVal3" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
        <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(3)" />
      </HorizontalLayout>
    </GridLayout>

    <!-- Unlock Special Tile -->
    <Text text="UNLOCK SPECIAL TILE (0 ACTIONS)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="4">
      <Button text="&lt;" preferredWidth="28" minWidth="28" color="#342d24" onClick="onHudUnlockPrev" />
      <Text id="hudUnlockNum" text="#1" preferredWidth="40" minWidth="40" alignment="MiddleCenter" fontStyle="Bold" color="#f5dc9c" />
      <Button text="&gt;" preferredWidth="28" minWidth="28" color="#342d24" onClick="onHudUnlockNext" />
      <Button id="btnHudUnlock" text="UNLOCK" preferredWidth="90" flexibleWidth="1" color="#7d5c20" onClick="onHudUnlockTile" />
    </HorizontalLayout>

    <!-- Quick Pull Core Tile, Travel Ext & Tile Menu Modal -->
    <Text text="CORE TILES (STEWARD'S TILE MENU)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
    <HorizontalLayout minHeight="24" preferredHeight="24" spacing="4">
      <Button text="&lt;" preferredWidth="26" minWidth="26" color="#342d24" onClick="onHudCorePrev" />
      <Text id="hudCoreName" text="Lumber Yard" flexibleWidth="1" fontSize="11" alignment="MiddleCenter" color="#f2ead4" />
      <Button text="&gt;" preferredWidth="26" minWidth="26" color="#342d24" onClick="onHudCoreNext" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="4">
      <Button text="PULL TILE" flexibleWidth="1" fontSize="10" color="#3b4d38" onClick="onHudPullCoreTile" tooltip="Pull the selected Core Tile above the Map Board" />
      <Button text="+EXT" preferredWidth="48" minWidth="48" fontSize="10" color="#4c4638" onClick="onHudPullTravelExt" tooltip="Pull a double-sided Travel Extension hex" />
      <Button text="TILE MENU" preferredWidth="92" minWidth="92" fontSize="10" color="#6c5222" onClick="onHudToggleTileMenu" tooltip="Open full Steward's Core Tile Menu with costs, effects &amp; 1-click Pull" />
    </HorizontalLayout>

    <!-- Score Sheet & Reset Game -->
    <HorizontalLayout minHeight="28" preferredHeight="28" spacing="4">
      <Button text="SCORE SHEET" flexibleWidth="1" fontSize="11" color="#523b5e" onClick="onHudOpenScoreSheet" tooltip="Open interactive Final Scoring &amp; Live Score breakdown modal" />
      <Button id="btnResetGame" text="RESET GAME" preferredWidth="112" minWidth="112" fontSize="11" color="#5a2422" onClick="onHudResetClick" tooltip="Click twice to return all tiles, cards, meeples, tokens, and counters to starting positions" />
    </HorizontalLayout>

  </VerticalLayout>
</Panel>

<!-- Scrollable Steward's Core Tile Menu Modal (toggled via TILE MENU button) -->
<Panel id="qvTileMenuModal"
       active="false"
       rectAlignment="MiddleCenter"
       width="760"
       height="620"
       color="#181512F6"
       outline="#c89e4c"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">
  <HorizontalLayout rectAlignment="UpperCenter" height="36" padding="12 8 6 6" color="#282118FF">
    <Text text="STEWARD'S GUIDE — CORE TILE MENU (v7.0)   |   W:Wood  St:Stone  M:Metal  F:Food  H:Herbs  G:Goods" fontSize="12" fontStyle="Bold" color="#ecd084" alignment="MiddleLeft" flexibleWidth="1" />
    <Button text="CLOSE" preferredWidth="68" minWidth="68" color="#6a2a24" onClick="onHudToggleTileMenu" />
  </HorizontalLayout>
  <VerticalScrollView rectAlignment="UpperCenter" offsetXY="0 -38" width="752" height="578" color="#18151200" scrollSensitivity="35" horizontalScrollbarVisibility="AutoHideAndExpandViewport">
    <VerticalLayout width="722" padding="8 8 8 8" spacing="4" childForceExpandHeight="false" childControlHeight="true" childForceExpandWidth="true" height="__QV_TILE_MENU_HEIGHT__">
__QV_TILE_MENU_ROWS__
    </VerticalLayout>
  </VerticalScrollView>
</Panel>

<!-- Interactive Final & Live Score Sheet Modal -->
<Panel id="qvScoreModal"
       active="false"
       rectAlignment="MiddleCenter"
       width="420"
       height="390"
       color="#181512F8"
       outline="#c89e4c"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">
  <HorizontalLayout rectAlignment="UpperCenter" height="34" padding="12 8 4 4" color="#282118FF">
    <Text text="STEWARD'S LEDGER — SCORE SHEET (v7.0)" fontSize="12" fontStyle="Bold" color="#ecd084" alignment="MiddleLeft" flexibleWidth="1" />
    <Button text="CLOSE" preferredWidth="62" minWidth="62" color="#6a2a24" onClick="onHudCloseScoreSheet" />
  </HorizontalLayout>
  <VerticalLayout rectAlignment="UpperCenter" offsetXY="0 -38" width="404" height="346" padding="12 12 8 8" spacing="6" childForceExpandHeight="false" childControlHeight="true">
    <Text id="scMapSummary" text="Working Tiles: 0  |  Overstrained: 0" fontSize="11" color="#c8d8be" minHeight="18" preferredHeight="18" />
    <Text id="scAutoLines" text="Population: +0  |  Tile Renown: +0\nStrain Tokens (0): -0  |  Active Burdens (0): -0" fontSize="12" color="#f0e4c8" minHeight="38" preferredHeight="38" />
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Quest Card Completed (+20)" flexibleWidth="1" fontSize="11" />
      <Button id="btnScQuest" text="NO (+0)" preferredWidth="90" color="#342e26" onClick="onScoreToggleQuest" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Steward Objectives Met (+15 each)" flexibleWidth="1" fontSize="11" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjObj(-1)" />
      <Text id="scObjVal" text="0 (+0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjObj(1)" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Golden Tile Goals Met (+5 each)" flexibleWidth="1" fontSize="11" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjGold(-1)" />
      <Text id="scGoldVal" text="0 (+0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjGold(1)" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Failed Arrivals (-10 each)" flexibleWidth="1" fontSize="11" color="#e8a49c" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjFail(-1)" />
      <Text id="scFailVal" text="0 (-0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" color="#e8a49c" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjFail(1)" />
    </HorizontalLayout>
    <Text id="scTotal" text="TOTAL SETTLEMENT SCORE: 0" fontSize="16" fontStyle="Bold" color="#f5d578" alignment="MiddleCenter" minHeight="32" preferredHeight="32" />
    <HorizontalLayout minHeight="28" preferredHeight="28" spacing="6">
      <Button text="RESCAN MAP" flexibleWidth="1" color="#3a4c62" onClick="onHudRefreshScore" />
      <Button text="BROADCAST TO CHAT" flexibleWidth="1" color="#6c5222" onClick="onHudBroadcastScore" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- Placement Warning / Alert Banner (! badge at top-center, auto-hides after 6s) -->
<Panel id="qvAlertBanner"
       active="false"
       rectAlignment="UpperCenter"
       offsetXY="0 -66"
       width="540"
       height="58"
       color="#361814F5"
       outline="#e89a38"
       outlineSize="2 -2">
  <HorizontalLayout padding="10 10 6 6" spacing="10" childForceExpandWidth="false">
    <Panel preferredWidth="36" minWidth="36" preferredHeight="36" color="#d97a1e" outline="#f8d890" outlineSize="1 -1">
      <Text text="!" fontSize="24" fontStyle="Bold" color="#18120c" alignment="MiddleCenter" />
    </Panel>
    <VerticalLayout flexibleWidth="1" spacing="2" childForceExpandHeight="false">
      <Text id="qvAlertTitle" text="PLACEMENT WARNING" fontSize="12" fontStyle="Bold" color="#f5b858" alignment="MiddleLeft" />
      <Text id="qvAlertBody" text="Tile cannot be placed here." fontSize="11" color="#f8eee0" alignment="MiddleLeft" />
    </VerticalLayout>
    <Button text="X" preferredWidth="28" minWidth="28" color="#5a2620" onClick="onHudDismissAlert" tooltip="Dismiss warning" />
  </HorizontalLayout>
</Panel>
