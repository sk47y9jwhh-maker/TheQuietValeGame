<Defaults>
  <Button fontStyle="Bold" fontSize="12" textColor="#f8f2e2" />
  <Text color="#f0e4c8" fontSize="12" />
</Defaults>

<Panel id="qvHudRoot"
       rectAlignment="MiddleLeft"
       offsetXY="14 28"
       width="304"
       height="518"
       color="#171411F5"
       outline="#c49b4a"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">

  <!-- Header bar -->
  <HorizontalLayout rectAlignment="UpperCenter" height="34" padding="10 6 5 5" spacing="4" color="#261f17FF">
    <Text id="qvTitle" text="THE QUIET VALE v7.0" fontSize="13" fontStyle="Bold" color="#ecc872" alignment="MiddleLeft" flexibleWidth="1" />
    <Button id="qvToggleBtn" text="-" preferredWidth="28" minWidth="28" color="#3b3125" onClick="onHudToggle" tooltip="Collapse / Expand Assistant" />
  </HorizontalLayout>

  <!-- Main collapsible body -->
  <VerticalLayout id="qvHudBody" rectAlignment="UpperCenter" offsetXY="0 -36" height="476" padding="8 8 4 8" spacing="6" childForceExpandHeight="false" childControlHeight="true">

    <!-- Top Navigation Tabs -->
    <HorizontalLayout minHeight="28" preferredHeight="28" spacing="4">
      <Button id="tabPlay" text="PLAY" fontSize="11" color="#8a6522" onClick="onHudTab(play)" />
      <Button id="tabTiles" text="TILES" fontSize="11" color="#2a241d" onClick="onHudTab(tiles)" />
      <Button id="tabSetup" text="SETUP" fontSize="11" color="#2a241d" onClick="onHudTab(setup)" />
    </HorizontalLayout>

    <!-- Status Strip (Always visible across tabs) -->
    <VerticalLayout minHeight="34" preferredHeight="34" spacing="1" padding="6 6 3 3" color="#221d16E0">
      <Text id="qvStatus" text="Season I  |  Round 1/12  |  2P (4 Act)" fontSize="11" fontStyle="Bold" color="#d8e8c8" alignment="MiddleCenter" minHeight="15" preferredHeight="15" />
      <Text id="qvPhaseCue" text="Step 1: Click REVEAL ENCOUNTERS to start Round 1" fontSize="10" fontStyle="Italic" color="#ecd084" alignment="MiddleCenter" minHeight="13" preferredHeight="13" />
    </VerticalLayout>

    <!-- ==================== TAB 1: PLAY ==================== -->
    <VerticalLayout id="panelPlay" active="true" spacing="6" childForceExpandHeight="false" childControlHeight="true" minHeight="388" preferredHeight="388">

      <!-- Active Turn & Steward Power Card -->
      <VerticalLayout minHeight="60" preferredHeight="60" spacing="4" padding="6 6 5 5" color="#252019EE">
        <HorizontalLayout minHeight="26" preferredHeight="26" spacing="4">
          <Text id="qvTurnInfo" text="Seat 1 (Vanguard) · 4/4" fontSize="11" fontStyle="Bold" color="#f5dc9c" flexibleWidth="1" alignment="MiddleLeft" />
          <Button text="-" preferredWidth="24" minWidth="24" color="#4e2a26" onClick="onHudActMinus" tooltip="Spend 1 Action" />
          <Button text="+" preferredWidth="24" minWidth="24" color="#2a4e30" onClick="onHudActPlus" tooltip="Refund 1 Action" />
          <Button id="btnNextTurn" text="NEXT TURN" preferredWidth="80" minWidth="80" fontSize="10" color="#364c64" onClick="onHudNextTurn" />
        </HorizontalLayout>
        <HorizontalLayout minHeight="22" preferredHeight="22" spacing="4">
          <Text id="qvPowerStatus" text="Vanguard Power: READY (1/Season)" fontSize="10" color="#a8d8a2" flexibleWidth="1" alignment="MiddleLeft" />
          <Button id="btnUsePower" text="USE POWER" preferredWidth="84" minWidth="84" fontSize="10" color="#325842" onClick="onHudUsePower" />
        </HorizontalLayout>
      </VerticalLayout>

      <!-- Primary Round Actions -->
      <Button id="btnRevealEnc" text="REVEAL ENCOUNTERS (2 CARDS)" minHeight="32" preferredHeight="32" fontSize="12" color="#a87622" onClick="onHudRevealEncounters" tooltip="Flip P Encounters into In Play &amp; place 3 Timers at base of Arrivals" />
      <HorizontalLayout minHeight="30" preferredHeight="30" spacing="6">
        <Button id="btnDrawTarget" text="TARGET CARD" flexibleWidth="1" fontSize="11" color="#324a5e" onClick="onHudDrawTarget" tooltip="Return previous Target Card to bottom &amp; flip next card" />
        <Button id="btnEndRound" text="END ROUND 1 -> 2" flexibleWidth="1" fontSize="11" color="#2d5c36" onClick="onHudEndRound" tooltip="Sweep X tokens, tick Arrival timers (-1), advance Round, rotate P1" />
      </HorizontalLayout>

      <!-- Warehouse (Cap 15) -->
      <Text text="WAREHOUSE (CAP 15 · SYNCED WITH 3D DISCS)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
      <GridLayout cellSize="138 25" spacing="8 4" minHeight="86" preferredHeight="86">
        <HorizontalLayout spacing="2">
          <Text text="Wood" preferredWidth="46" fontSize="11" color="#a6c890" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(4)" />
          <Text id="whVal4" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(4)" />
        </HorizontalLayout>
        <HorizontalLayout spacing="2">
          <Text text="Stone" preferredWidth="46" fontSize="11" color="#b6c0c6" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(1)" />
          <Text id="whVal1" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(1)" />
        </HorizontalLayout>
        <HorizontalLayout spacing="2">
          <Text text="Metal" preferredWidth="46" fontSize="11" color="#9ab8ca" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(2)" />
          <Text id="whVal2" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(2)" />
        </HorizontalLayout>
        <HorizontalLayout spacing="2">
          <Text text="Food" preferredWidth="46" fontSize="11" color="#d8c66e" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(5)" />
          <Text id="whVal5" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(5)" />
        </HorizontalLayout>
        <HorizontalLayout spacing="2">
          <Text text="Herbs" preferredWidth="46" fontSize="11" color="#bfa0d0" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(6)" />
          <Text id="whVal6" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(6)" />
        </HorizontalLayout>
        <HorizontalLayout spacing="2">
          <Text text="Goods" preferredWidth="46" fontSize="11" color="#d69676" />
          <Button text="-" preferredWidth="22" color="#4a2a26" onClick="onHudWhMinus(3)" />
          <Text id="whVal3" text="0" preferredWidth="28" alignment="MiddleCenter" fontStyle="Bold" />
          <Button text="+" preferredWidth="22" color="#2a4a2e" onClick="onHudWhPlus(3)" />
        </HorizontalLayout>
      </GridLayout>

      <!-- Quick Modals Footer -->
      <HorizontalLayout minHeight="30" preferredHeight="30" spacing="6">
        <Button text="CORE TILE MENU" flexibleWidth="1" fontSize="11" color="#6c5222" onClick="onHudToggleTileMenu" />
        <Button text="SCORE SHEET" flexibleWidth="1" fontSize="11" color="#523b5e" onClick="onHudOpenScoreSheet" />
      </HorizontalLayout>

      <!-- 1-Click Right-Side-Up Camera Presets (moves only clicking player's camera) -->
      <HorizontalLayout minHeight="26" preferredHeight="26" spacing="5">
        <Button text="VIEW MAP" flexibleWidth="1" fontSize="10" color="#2e3e36" onClick="onHudFocusCam(map)" tooltip="Pan smoothly to frame the Map Board" />
        <Button text="ENCOUNTERS" flexibleWidth="1" fontSize="10" color="#3c3426" onClick="onHudFocusCam(encounters)" tooltip="Pan smoothly to frame the Encounter Board" />
        <Button text="FULL TABLE" flexibleWidth="1" fontSize="10" color="#2c323c" onClick="onHudFocusCam(table)" tooltip="Zoom out to view the entire table" />
      </HorizontalLayout>

    </VerticalLayout>

    <!-- ==================== TAB 2: TILES ==================== -->
    <VerticalLayout id="panelTiles" active="false" spacing="8" childForceExpandHeight="false" childControlHeight="true" minHeight="358" preferredHeight="358">

      <Button text="OPEN FULL CORE TILE MENU (21 TILES)" minHeight="34" preferredHeight="34" fontSize="12" color="#785a24" onClick="onHudToggleTileMenu" />

      <Text text="QUICK-PULL CORE TILE" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
      <HorizontalLayout minHeight="28" preferredHeight="28" spacing="4">
        <Button text="&lt;" preferredWidth="30" minWidth="30" color="#342d24" onClick="onHudCorePrev" />
        <Text id="hudCoreName" text="Lumber Yard" flexibleWidth="1" fontSize="12" fontStyle="Bold" alignment="MiddleCenter" color="#f2ead4" />
        <Button text="&gt;" preferredWidth="30" minWidth="30" color="#342d24" onClick="onHudCoreNext" />
      </HorizontalLayout>
      <HorizontalLayout minHeight="30" preferredHeight="30" spacing="6">
        <Button text="PULL CORE TILE" flexibleWidth="1" fontSize="11" color="#3b5438" onClick="onHudPullCoreTile" />
        <Button text="+TRAVEL EXT." preferredWidth="104" minWidth="104" fontSize="11" color="#4e4638" onClick="onHudPullTravelExt" />
      </HorizontalLayout>

      <Text text="UNLOCK SPECIAL TILE (0 ACTIONS TO PLACE)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
      <HorizontalLayout minHeight="30" preferredHeight="30" spacing="4">
        <Button text="&lt;" preferredWidth="32" minWidth="32" color="#342d24" onClick="onHudUnlockPrev" />
        <Text id="hudUnlockNum" text="#1" preferredWidth="46" minWidth="46" alignment="MiddleCenter" fontStyle="Bold" color="#f5dc9c" />
        <Button text="&gt;" preferredWidth="32" minWidth="32" color="#342d24" onClick="onHudUnlockNext" />
        <Button id="btnHudUnlock" text="UNLOCK" flexibleWidth="1" color="#7d5c20" onClick="onHudUnlockTile" />
      </HorizontalLayout>

      <VerticalLayout minHeight="96" preferredHeight="96" padding="8 8 6 6" color="#221d16CC">
        <Text text="RIGHT-CLICK SHORTCUTS ON THE TABLE" fontSize="10" fontStyle="Bold" color="#e8c474" minHeight="16" preferredHeight="16" />
        <Text text="• Map Tile: Activate, Pay Cost, Upgrade, +/- Strain, +Shield\n• Arrival Card: Welcome &amp; Unlock Special Tile, +1 Timer\n• Burden Card: Resolve (pays Season 3/5/7 cost &amp; discards)\n• Drop a tile on a Meeple: tile slides cleanly under it!" fontSize="10" color="#d8ceb8" alignment="UpperLeft" minHeight="70" preferredHeight="70" />
      </VerticalLayout>

    </VerticalLayout>

    <!-- ==================== TAB 3: SETUP ==================== -->
    <VerticalLayout id="panelSetup" active="false" spacing="8" childForceExpandHeight="false" childControlHeight="true" minHeight="358" preferredHeight="358">

      <Text text="1. START NEW GAME BY PLAYER COUNT" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
      <HorizontalLayout minHeight="32" preferredHeight="32" spacing="4">
        <Button id="btnSetup1" text="1P" color="#2e2922" onClick="onHudSetup(1)" tooltip="1P: 4 Actions, 15 Warehouse, 5/3/4 Encounters" />
        <Button id="btnSetup2" text="2P" color="#7a5d26" onClick="onHudSetup(2)" tooltip="2P: 4 Actions, 10 Warehouse, 8/8/8 Encounters" />
        <Button id="btnSetup3" text="3P" color="#2e2922" onClick="onHudSetup(3)" tooltip="3P: 3 Actions, 8 Warehouse, 12/12/12 Encounters" />
        <Button id="btnSetup4" text="4P" color="#2e2922" onClick="onHudSetup(4)" tooltip="4P: 3 Actions, 0 Warehouse, 16/16/16 Encounters" />
        <Button id="btnSetup5" text="5P" color="#2e2922" onClick="onHudSetup(5)" tooltip="5P: 2 Actions, 0 Warehouse, 26/14/20 Encounters" />
      </HorizontalLayout>

      <Text text="2. ENCOUNTER DECK SEEDING (3 CARDS / SEASON)" fontSize="10" fontStyle="Bold" color="#c9a862" minHeight="14" preferredHeight="14" />
      <Text text="At the start of Seasons I, II, and III, each player seeds 3 cards (1 Top, 1 Middle, 1 Bottom) from their hand via the Seeding Window." fontSize="10" color="#d8ceb8" minHeight="38" preferredHeight="38" />
      <Button text="OPEN SEASON SEEDING WINDOW" minHeight="32" preferredHeight="32" fontSize="11" color="#445c38" onClick="onHudOpenSeeding" tooltip="Open the interactive Seasonal Seeding window (1 Top / 1 Mid / 1 Bot)" />
      <Button id="btnQuickSeed" text="QUICK-SEED THIS SEASON" minHeight="28" preferredHeight="28" fontSize="11" color="#3c3428" onClick="onHudQuickSeed" tooltip="Auto-seed 1 Top / 1 Mid / 1 Bot per player for the current Season" />

      <Text text="3. RESET TABLE" fontSize="10" fontStyle="Bold" color="#d4887c" minHeight="14" preferredHeight="14" />
      <Button id="btnResetGame" text="RESET GAME (2-CLICK CONFIRM)" minHeight="32" preferredHeight="32" fontSize="11" color="#622422" onClick="onHudResetClick" tooltip="Click twice to return all tiles, cards, meeples, tokens, and counters to starting positions" />

    </VerticalLayout>

  </VerticalLayout>
</Panel>

<!-- Scrollable Steward's Core Tile Menu Modal (toggled via TILE MENU button) -->
<Panel id="qvTileMenuModal"
       active="false"
       rectAlignment="MiddleCenter"
       width="760"
       height="620"
       color="#181512F6"
       outline="#c89e4c"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">
  <HorizontalLayout rectAlignment="UpperCenter" height="36" padding="12 8 6 6" color="#282118FF">
    <Text text="STEWARD'S GUIDE — CORE TILE MENU (v7.0)   |   W:Wood  St:Stone  M:Metal  F:Food  H:Herbs  G:Goods" fontSize="12" fontStyle="Bold" color="#ecd084" alignment="MiddleLeft" flexibleWidth="1" />
    <Button text="CLOSE" preferredWidth="68" minWidth="68" color="#6a2a24" onClick="onHudToggleTileMenu" />
  </HorizontalLayout>
  <VerticalScrollView rectAlignment="UpperCenter" offsetXY="0 -38" width="752" height="578" color="#18151200" scrollSensitivity="35" horizontalScrollbarVisibility="AutoHideAndExpandViewport">
    <VerticalLayout width="722" padding="8 8 8 8" spacing="4" childForceExpandHeight="false" childControlHeight="true" childForceExpandWidth="true" height="__QV_TILE_MENU_HEIGHT__">
__QV_TILE_MENU_ROWS__
    </VerticalLayout>
  </VerticalScrollView>
</Panel>

<!-- Interactive Final & Live Score Sheet Modal -->
<Panel id="qvScoreModal"
       active="false"
       rectAlignment="MiddleCenter"
       width="420"
       height="390"
       color="#181512F8"
       outline="#c89e4c"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">
  <HorizontalLayout rectAlignment="UpperCenter" height="34" padding="12 8 4 4" color="#282118FF">
    <Text text="STEWARD'S LEDGER — SCORE SHEET (v7.0)" fontSize="12" fontStyle="Bold" color="#ecd084" alignment="MiddleLeft" flexibleWidth="1" />
    <Button text="CLOSE" preferredWidth="62" minWidth="62" color="#6a2a24" onClick="onHudCloseScoreSheet" />
  </HorizontalLayout>
  <VerticalLayout rectAlignment="UpperCenter" offsetXY="0 -38" width="404" height="346" padding="12 12 8 8" spacing="6" childForceExpandHeight="false" childControlHeight="true">
    <Text id="scMapSummary" text="Working Tiles: 0  |  Overstrained: 0" fontSize="11" color="#c8d8be" minHeight="18" preferredHeight="18" />
    <Text id="scAutoLines" text="Population: +0  |  Tile Renown: +0\nStrain Tokens (0): -0  |  Active Burdens (0): -0" fontSize="12" color="#f0e4c8" minHeight="38" preferredHeight="38" />
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Quest Card Completed (+20)" flexibleWidth="1" fontSize="11" />
      <Button id="btnScQuest" text="NO (+0)" preferredWidth="90" color="#342e26" onClick="onScoreToggleQuest" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Steward Objectives Met (+15 each)" flexibleWidth="1" fontSize="11" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjObj(-1)" />
      <Text id="scObjVal" text="0 (+0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjObj(1)" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Golden Tile Goals Met (+5 each)" flexibleWidth="1" fontSize="11" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjGold(-1)" />
      <Text id="scGoldVal" text="0 (+0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjGold(1)" />
    </HorizontalLayout>
    <HorizontalLayout minHeight="26" preferredHeight="26" spacing="6">
      <Text text="Failed Arrivals (-10 each)" flexibleWidth="1" fontSize="11" color="#e8a49c" />
      <Button text="-" preferredWidth="26" color="#4a2a26" onClick="onScoreAdjFail(-1)" />
      <Text id="scFailVal" text="0 (-0)" preferredWidth="64" alignment="MiddleCenter" fontStyle="Bold" color="#e8a49c" />
      <Button text="+" preferredWidth="26" color="#2a4a2e" onClick="onScoreAdjFail(1)" />
    </HorizontalLayout>
    <Text id="scTotal" text="TOTAL SETTLEMENT SCORE: 0" fontSize="16" fontStyle="Bold" color="#f5d578" alignment="MiddleCenter" minHeight="32" preferredHeight="32" />
    <HorizontalLayout minHeight="28" preferredHeight="28" spacing="6">
      <Button text="RESCAN MAP" flexibleWidth="1" color="#3a4c62" onClick="onHudRefreshScore" />
      <Button text="BROADCAST TO CHAT" flexibleWidth="1" color="#6c5222" onClick="onHudBroadcastScore" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- Interactive Seasonal Encounter Seeding Modal (3 cards per player at start of Seasons I, II, III) -->
<Panel id="qvSeedingModal"
       active="false"
       rectAlignment="MiddleCenter"
       width="780"
       height="526"
       color="#171411F8"
       outline="#c89e4c"
       outlineSize="2 -2"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false">
